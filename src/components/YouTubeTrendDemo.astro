---
import { youtubeTrendSnapshot } from '../data/youtubeTrend';
---

<section class="yt-demo-wrap reveal" id="demo">
  <div class="yt-demo-shell" data-yt-demo>
    <div class="yt-demo-topbar">
      <div class="yt-window-dots">
        <span></span><span></span><span></span>
        <strong>Keyword Gap → Shoot Brief</strong>
      </div>
      <span class="yt-live-badge">KR · SaaS</span>
    </div>

    <div class="yt-demo-body">
      <div class="yt-kpi-grid">
        <div class="yt-kpi">
          <p>Keyword</p>
          <strong>{youtubeTrendSnapshot.keyword}</strong>
        </div>
        <div class="yt-kpi">
          <p>Verdict</p>
          <strong>{youtubeTrendSnapshot.verdict}</strong>
        </div>
        <div class="yt-kpi">
          <p>Eng. gap</p>
          <strong>{youtubeTrendSnapshot.engagementGap}</strong>
        </div>
        <div class="yt-kpi">
          <p>Overlap</p>
          <strong>{youtubeTrendSnapshot.overlap}</strong>
        </div>
      </div>

      <div class="yt-tabs" role="tablist">
        <button type="button" class="yt-tab is-active" data-tab="trending">Gap Report</button>
        <button type="button" class="yt-tab" data-tab="keyword">Shoot Brief</button>
        <button type="button" class="yt-tab" data-tab="insight">Action</button>
      </div>

      <div class="yt-demo-grid">
        <div class="yt-panel-main">
          <div data-panel="trending">
            <p class="yt-label">Gap vs KR trending baseline</p>
            <p>Keyword: <strong>{youtubeTrendSnapshot.keyword}</strong></p>
            <p>Category overlap: <strong class="yt-accent">{youtubeTrendSnapshot.overlap}</strong></p>
            <p>Engagement gap: <strong>{youtubeTrendSnapshot.engagementGap}</strong></p>
          </div>
          <div data-panel="keyword" hidden>
            <p class="yt-label">Shoot Brief — 이번 주 1편</p>
            <p>Format: <strong>{youtubeTrendSnapshot.format}</strong></p>
            <p>Hook: <strong>{youtubeTrendSnapshot.titleHook}</strong></p>
            <p>Title: <strong>{youtubeTrendSnapshot.titleExample}</strong></p>
          </div>
          <div data-panel="insight" hidden>
            <p class="yt-label">This week action</p>
            <ul>
              <li>Long-form 3분 · How-to 훅 · SaaS 실전 가이드 1편 촬영</li>
              <li>Tags: {youtubeTrendSnapshot.testTags.join(' ')}</li>
              <li>Markdown Shoot Brief 원클릭 export</li>
            </ul>
          </div>
        </div>

        <aside class="yt-panel-side">
          <p class="yt-label">Marketing presets</p>
          <div class="yt-chips">
            <button type="button" class="yt-chip is-active" data-format="all">SaaS</button>
            <button type="button" class="yt-chip" data-format="shorts">AI 마케팅</button>
            <button type="button" class="yt-chip" data-format="long">CRM</button>
          </div>
          <p class="yt-label" style="margin-top: 16px">Test tags</p>
          <div class="yt-keywords">
            {youtubeTrendSnapshot.testTags.map((kw) => (
              <span>{kw}</span>
            ))}
          </div>
          <button type="button" class="yt-refresh" data-yt-refresh>↻ API 데이터 새로고침</button>
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .yt-demo-shell {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 77, 109, 0.25);
    background: linear-gradient(135deg, #0f0f0f 0%, #212121 50%, #3d0000 100%);
    box-shadow: 0 24px 60px rgba(15, 15, 15, 0.35);
  }

  .yt-demo-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid rgba(255, 77, 109, 0.2);
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
  }

  .yt-window-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .yt-window-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .yt-window-dots span:nth-child(2) {
    background: #febc2e;
  }

  .yt-window-dots span:nth-child(3) {
    background: #28c840;
  }

  .yt-live-badge {
    border: 1px solid rgba(255, 77, 109, 0.4);
    background: rgba(255, 77, 109, 0.15);
    color: #ff8fa3;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .yt-demo-body {
    padding: 20px;
    color: rgba(255, 255, 255, 0.85);
  }

  .yt-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .yt-kpi {
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(145deg, #1a1a1a, #252525);
    padding: 12px 14px;
  }

  .yt-kpi p {
    margin: 0 0 4px;
    font-size: 10px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .yt-kpi strong {
    font-size: 22px;
    color: #fff;
  }

  .yt-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 16px;
  }

  .yt-tab,
  .yt-chip {
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }

  .yt-tab.is-active,
  .yt-chip.is-active {
    border-color: rgba(255, 77, 109, 0.5);
    background: rgba(255, 77, 109, 0.2);
    color: #ff8fa3;
  }

  .yt-demo-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
  }

  .yt-label {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .yt-bar-row {
    display: grid;
    grid-template-columns: 88px 1fr 36px;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
    font-size: 12px;
  }

  .yt-bar {
    height: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .yt-bar i {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, #ff0033, #ff8fa3);
  }

  .yt-bar-row em {
    font-style: normal;
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
  }

  .yt-accent {
    color: #ff8fa3;
  }

  .yt-panel-main ul {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.7;
  }

  .yt-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .yt-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .yt-keywords span {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 77, 109, 0.15);
    color: #ff8fa3;
    border: 1px solid rgba(255, 77, 109, 0.25);
  }

  .yt-refresh {
    margin-top: 16px;
    width: 100%;
    border: 1px dashed rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.75);
    border-radius: 10px;
    padding: 10px;
    font-size: 12px;
    cursor: pointer;
  }

  .yt-refresh.is-spinning {
    animation: spin 0.7s linear;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 768px) {
    .yt-kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .yt-demo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
