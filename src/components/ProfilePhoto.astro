---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  alt?: string;
}

const { size = 'md', alt = '강반석 프로필 사진' } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = `${base}images/profile.png`;
---

<img class={`profile-photo profile-photo-${size}`} src={src} alt={alt} width="320" height="400" loading="lazy" />

<style>
  .profile-photo {
    display: block;
    max-width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: 2px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .profile-photo-sm {
    width: 96px;
  }

  .profile-photo-md {
    width: min(200px, 100%);
  }

  .profile-photo-lg {
    width: min(280px, 100%);
  }
</style>
