---
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
import { primaryResumeDownload } from '../data/pdfDownloads';
import { publicAssetExists, publicAssetUrl } from '../utils/assets';

const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}work/`, label: 'Work' },
  { href: `${base}resume/`, label: 'Resume' },
  { href: `${base}about/`, label: 'About' },
  { href: `${base}contact/`, label: 'Contact' }
];

const hasPrimaryPdf = publicAssetExists(primaryResumeDownload.filename);
const primaryPdfHref = hasPrimaryPdf
  ? publicAssetUrl(base, primaryResumeDownload.filename)
  : `${base}work/`;
---

<header class="site-header">
  <nav class="nav-inner" aria-label="Main navigation">
    <a class="brand" href={base}>
      <span class="brand-mark" aria-hidden="true">GK</span>
      <span class="brand-copy">
        <strong>{profile.nameEn}</strong>
        <span>{profile.role}</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />

    <div class="nav-links">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav-cta" href={primaryPdfHref} download={hasPrimaryPdf || undefined}>
        {hasPrimaryPdf ? 'Resume PDF' : 'View Cases'}
      </a>
    </div>

    <div class="nav-end">
      <ThemeToggle />
      <label for="nav-toggle" class="nav-menu-btn" aria-label="Toggle navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </label>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll('.nav-links a').forEach((link) => {
    link.addEventListener('click', () => {
      const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
      if (toggle) toggle.checked = false;
    });
  });
</script>
