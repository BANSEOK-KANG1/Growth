---
interface Props {
  current: 'home' | 'work' | 'resume' | 'baro';
  compact?: boolean;
}

const { current, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  {
    id: 'home' as const,
    href: base,
    label: 'Growth 홈',
    hint: '포지션 · 케이스 요약'
  },
  {
    id: 'work' as const,
    href: `${base}work/`,
    label: 'Work Archive',
    hint: '케이스 · 프로젝트 · 지원 자료'
  },
  {
    id: 'resume' as const,
    href: `${base}resume/`,
    label: '직무별 이력서',
    hint: 'Performance · CRM · Growth PM'
  },
  {
    id: 'baro' as const,
    href: `${base}baro-interactive/`,
    label: '바로인터랙티브',
    hint: 'JD 맞춤 지원 페이지'
  }
];
---

<nav class:list={['portfolio-cross-links', compact && 'is-compact']} aria-label="포트폴리오 주요 페이지">
  {
    links.map((link) =>
      link.id === current ? (
        <span class="portfolio-cross-links__item is-current" aria-current="page">
          <strong>{link.label}</strong>
          {!compact && <span>{link.hint}</span>}
        </span>
      ) : (
        <a class="portfolio-cross-links__item" href={link.href}>
          <strong>{link.label}</strong>
          {!compact && <span>{link.hint}</span>}
        </a>
      )
    )
  }
</nav>

<style>
  .portfolio-cross-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .portfolio-cross-links.is-compact {
    margin-top: 12px;
  }

  .portfolio-cross-links__item {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    min-width: min(100%, 160px);
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  a.portfolio-cross-links__item:hover {
    border-color: var(--primary);
    box-shadow: none;
    transform: none;
  }

  .portfolio-cross-links__item.is-current {
    border-color: var(--primary);
    background: var(--surface-soft);
  }

  .portfolio-cross-links__item strong {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text);
  }

  .portfolio-cross-links__item span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
</style>
