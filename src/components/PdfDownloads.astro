---
import type { PdfDownload } from '../data/pdfDownloads';
import { publicAssetExists, publicAssetUrl } from '../utils/assets';

interface Props {
  items: PdfDownload[];
  variant?: 'grid' | 'list';
  showEmpty?: boolean;
}

const { items, variant = 'grid', showEmpty = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const available = items.filter((item) => publicAssetExists(item.filename));
---

{
  available.length > 0 ? (
    variant === 'list' ? (
      <div class="pdf-list">
        {available.map((item) => (
          <a class="pdf-link" href={publicAssetUrl(base, item.filename)} download>
            <strong>{item.label}</strong>
            <span>{item.description}</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="pdf-grid">
        {available.map((item) => (
          <article class="pdf-card">
            {item.primary && <span class="pill">Recommended</span>}
            <h3>{item.label}</h3>
            <p>{item.description}</p>
            <div class="tag-list">
              {item.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <a class="btn-primary pdf-card-btn" href={publicAssetUrl(base, item.filename)} download>
              다운로드
            </a>
          </article>
        ))}
      </div>
    )
  ) : showEmpty ? (
    <div class="pdf-empty">
      <p>
        PDF 파일을 <code>public/files/</code> 폴더에 추가하면 자동으로 다운로드 버튼이 표시됩니다.
      </p>
      <a class="text-link" href={`${base}resume/`}>
        Resume 페이지에서 파일명 확인 →
      </a>
    </div>
  ) : null
}

<style>
  .pdf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--grid-gap);
  }

  .pdf-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    padding: 22px;
    box-shadow: var(--shadow);
  }

  .pdf-card h3 {
    margin-top: 10px;
  }

  .pdf-card-btn {
    margin-top: 16px;
    display: inline-flex;
  }

  .pdf-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pdf-link {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    background: var(--surface-soft);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .pdf-link:hover {
    border-color: var(--primary);
    transform: translateX(4px);
  }

  .pdf-link strong {
    display: block;
    margin-bottom: 4px;
  }

  .pdf-link span {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .pdf-empty {
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    padding: 24px;
    background: var(--surface-soft);
    color: var(--muted);
  }

  .pdf-empty p {
    margin: 0 0 12px;
  }
</style>
