---
import { campaignSummaries, getDecisionLabel } from '../data/metrics';
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Channel</th>
        <th>Campaign</th>
        <th>Spend</th>
        <th>CVR</th>
        <th>CPA</th>
        <th>Lead Quality</th>
        <th>Meeting Rate</th>
        <th>Decision</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      {campaignSummaries.map((row) => (
        <tr>
          <td>{row.channel}</td>
          <td><strong>{row.campaign}</strong></td>
          <td>{row.spend}</td>
          <td>{row.cvr}</td>
          <td>{row.cpa}</td>
          <td>{row.leadQuality}</td>
          <td>{row.meetingRate}</td>
          <td><span class={`decision-badge decision-${row.decision}`}>{getDecisionLabel(row.decision)}</span></td>
          <td>{row.action}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .decision-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 2px;
    white-space: nowrap;
  }

  .decision-expand {
    background: #dbeafe;
    color: #1d4ed8;
  }

  .decision-maintain {
    background: #d1fae5;
    color: #047857;
  }

  .decision-reduce {
    background: #fee2e2;
    color: #b91c1c;
  }

  .decision-experiment {
    background: #fef3c7;
    color: #b45309;
  }
</style>
