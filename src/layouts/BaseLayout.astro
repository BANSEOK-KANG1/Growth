---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import '../styles/global.css';

const {
  title = 'Growth Performance Portfolio — Kang Banseok',
  description = '인하우스 퍼포먼스/그로스/CRM 직무 지원을 위한 강반석의 포트폴리오입니다.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, profile.siteUrl).href;
const ogImage = new URL(`${base}og-image.svg`, profile.siteUrl).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2457c5" />
    <meta name="author" content={profile.nameKo} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script src={`${base}scripts/portfolio.js`} defer></script>
  </body>
</html>
