---
import BaseLayout from './BaseLayout.astro';
import { profile } from '../data/profile';

const { entry } = Astro.props;
const data = entry.data;
const backHref = `${import.meta.env.BASE_URL}cases/`;
---

<BaseLayout
  title={`${data.title} | ${profile.nameKo} Portfolio`}
  description={data.summary}
  ogType="article"
  keywords={[data.category, ...data.metrics, ...data.tools, profile.nameKo]}
>
  <section class="case-hero">
    <div class="container case-hero-inner">
      <div>
        <a class="text-link" href={backHref}>← Cases로 돌아가기</a>
        <div style="height: 18px"></div>
        <span class="eyebrow">{data.category}</span>
        <h1>{data.title}</h1>
        {data.subtitle && <p>{data.subtitle}</p>}
        <div class="tag-list">
          <span class="tag">{data.period}</span>
          <span class="tag">{data.status}</span>
          {data.metrics.slice(0, 4).map((metric) => <span class="tag">{metric}</span>)}
        </div>
      </div>
      <div class="metric-card">
        <span>Core Signal</span>
        <strong>{data.heroMetric || 'Problem → Metric → Action'}</strong>
      </div>
    </div>
  </section>

  <div class="content-shell">
    <article class="prose">
      <slot />
    </article>
    <aside class="case-sidebar">
      <div class="sidebar-card">
        <h3>Tools</h3>
        <div class="sidebar-list">
          {data.tools.map((tool) => <span class="pill">{tool}</span>)}
        </div>
      </div>
      <div class="sidebar-card">
        <h3>Metrics</h3>
        <div class="sidebar-list">
          {data.metrics.map((metric) => <span class="pill">{metric}</span>)}
        </div>
      </div>
      <div class="sidebar-card status-note">
        <h3>작성 기준</h3>
        <p>실제 경험 기반으로 작성하되, 회사명·광고비·전환 수치는 필요 시 익명화/범위값으로 처리하는 것을 권장합니다.</p>
      </div>
    </aside>
  </div>
</BaseLayout>
