---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { resumeDownloads } from '../data/resumeDownloads';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const portfolioHref = `${base}${profile.portfolioPdfPath.replace(/^\//, '')}`;
const portfolioExists = fs.existsSync(path.join(process.cwd(), 'public', profile.portfolioPdfPath));

const availableDownloads = resumeDownloads.filter((item) =>
  fs.existsSync(path.join(process.cwd(), 'public', item.filename))
);
---

<BaseLayout title="Contact | Kang Banseok Portfolio" description="강반석 포트폴리오 연락처 페이지입니다.">
  <section class="page-hero reveal">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>성과 흐름을 함께 개선할 수 있는 팀을 찾고 있습니다</h1>
      <p>인하우스 퍼포먼스 마케팅, 그로스 마케팅, CRM/Marketing Ops, Growth PM Assistant 포지션을 중심으로 지원합니다.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <article class="info-panel reveal">
        <h2>Contact</h2>
        <p><strong>Email</strong><br /><a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p><strong>Mobile</strong><br /><a class="text-link" href={`tel:${profile.phone.replace(/-/g, '')}`}>{profile.phone}</a></p>
        <p><strong>Location</strong><br />{profile.location}</p>
        <p><strong>GitHub</strong><br /><a class="text-link" href={profile.githubUrl} target="_blank" rel="noreferrer">{profile.githubUrl}</a></p>
        <p><strong>Notion</strong><br /><a class="text-link" href={profile.notionUrl} target="_blank" rel="noreferrer">프로젝트 허브 DB</a></p>
      </article>
      <article class="info-panel reveal">
        <h2>Resume PDF</h2>
        <p style="color: var(--muted); margin-bottom: 16px">직무에 맞는 이력서를 선택해 다운로드하세요.</p>
        <div class="pdf-list">
          {availableDownloads.map((item) => (
            <a class="pdf-link" href={`${base}${item.filename.replace(/^\//, '')}`} download>
              <strong>{item.label}</strong>
              <span>{item.description}</span>
            </a>
          ))}
        </div>
        {portfolioExists ? (
          <a class="btn-secondary" href={portfolioHref} download style="margin-top: 16px; display: inline-flex">
            Portfolio PDF
          </a>
        ) : null}
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .pdf-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pdf-link {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    background: var(--surface-soft);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .pdf-link:hover {
    border-color: var(--primary);
    transform: translateX(4px);
  }

  .pdf-link strong {
    display: block;
    margin-bottom: 4px;
  }

  .pdf-link span {
    font-size: 13px;
    color: var(--muted);
  }
</style>
