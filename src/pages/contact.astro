---
import BaseLayout from '../layouts/BaseLayout.astro';
import PdfDownloads from '../components/PdfDownloads.astro';
import { profile } from '../data/profile';
import { allPdfDownloads } from '../data/pdfDownloads';
---

<BaseLayout
  title={`Contact | ${profile.nameKo} Portfolio`}
  description={`${profile.nameKo}(${profile.nameEn}) 포트폴리오 연락처 · 이력서 PDF 다운로드.`}
  keywords={[...profile.keywords, '연락처', 'Contact', profile.nameKo]}
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>성장 문제를 함께 구조화할 팀을 찾고 있습니다</h1>
      <p>Growth Operations, Marketing Analytics, CRM/Marketing Ops, Growth PM·Product Operations 포지션을 중심으로 지원합니다.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <article class="info-panel reveal">
        <h2>Contact</h2>
        <p><strong>Email</strong><br /><a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p><strong>Mobile</strong><br /><a class="text-link" href={`tel:${profile.phone.replace(/-/g, '')}`}>{profile.phone}</a></p>
        <p><strong>Location</strong><br />{profile.location}</p>
        <p><strong>GitHub</strong><br /><a class="text-link" href={profile.githubUrl} target="_blank" rel="noreferrer">{profile.githubUrl}</a></p>
        <p><strong>Notion</strong><br /><a class="text-link" href={profile.notionUrl} target="_blank" rel="noreferrer">프로젝트 허브 DB</a></p>
      </article>
      <article class="info-panel reveal">
        <h2>Resume & Portfolio PDF</h2>
        <p style="color: var(--muted); margin-bottom: 16px">직무에 맞는 이력서 PDF를 선택해 다운로드하세요.</p>
        <PdfDownloads items={allPdfDownloads} variant="list" showEmpty />
        <a class="btn-secondary" href={`${import.meta.env.BASE_URL}resume/`} style="margin-top: 16px; display: inline-flex">
          Resume 페이지에서 미리보기
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
