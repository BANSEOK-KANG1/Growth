---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const resumeHref = `${base}${profile.resumePdfPath.replace(/^\//, '')}`;
const portfolioHref = `${base}${profile.portfolioPdfPath.replace(/^\//, '')}`;

const resumeExists = fs.existsSync(path.join(process.cwd(), 'public', profile.resumePdfPath));
const portfolioExists = fs.existsSync(path.join(process.cwd(), 'public', profile.portfolioPdfPath));
---

<BaseLayout title="Contact | Kang Banseok Portfolio" description="강반석 포트폴리오 연락처 페이지입니다.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>성과 흐름을 함께 개선할 수 있는 팀을 찾고 있습니다</h1>
      <p>인하우스 퍼포먼스 마케팅, 그로스 마케팅, CRM/Marketing Ops, Growth PM Assistant 포지션을 중심으로 지원합니다.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <article class="info-panel">
        <h2>Links</h2>
        <p><strong>Email</strong><br /><a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p><strong>GitHub</strong><br /><a class="text-link" href={profile.githubUrl} target="_blank" rel="noreferrer">{profile.githubUrl}</a></p>
        <p><strong>Notion</strong><br /><a class="text-link" href={profile.notionUrl} target="_blank" rel="noreferrer">{profile.notionUrl}</a></p>
      </article>
      <article class="info-panel">
        <h2>PDF Files</h2>
        <div class="hero-actions">
          {resumeExists ? (
            <a class="btn-primary" href={resumeHref} download>Resume PDF</a>
          ) : (
            <span class="btn-secondary pdf-unavailable">Resume PDF · 준비 중</span>
          )}
          {portfolioExists ? (
            <a class="btn-secondary" href={portfolioHref} download>Portfolio PDF</a>
          ) : (
            <span class="btn-secondary pdf-unavailable">Portfolio PDF · 준비 중</span>
          )}
        </div>
        {!resumeExists || !portfolioExists ? (
          <p class="pdf-note">PDF 파일은 `public/files/`에 추가하면 자동으로 링크가 활성화됩니다.</p>
        ) : null}
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .pdf-unavailable {
    opacity: 0.65;
    cursor: default;
    pointer-events: none;
  }

  .pdf-note {
    margin-top: 16px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
