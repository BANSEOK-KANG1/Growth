---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import ToolStack from '../components/ToolStack.astro';
import { profile } from '../data/profile';
import { resumeTimeline, coreTools, supplementarySkills } from '../data/resume';
import { education } from '../data/profile';
import { resumeDownloads } from '../data/resumeDownloads';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;

const availableDownloads = resumeDownloads.filter((item) =>
  fs.existsSync(path.join(process.cwd(), 'public', item.filename))
);
---

<BaseLayout title="Resume | Kang Banseok Portfolio" description="강반석의 퍼포먼스/그로스/CRM 직무용 이력서 요약 페이지입니다.">
  <section class="page-hero">
    <div class="container resume-hero reveal">
      <ProfilePhoto size="lg" />
      <div>
        <span class="eyebrow">Resume Summary</span>
        <h1>{profile.nameKo}</h1>
        <p>{profile.headline}</p>
        <p style="color: var(--muted); margin-top: 8px">
          {profile.location} · {profile.email} · {profile.phone}
        </p>
        <div class="tag-list">
          {profile.targetRoles.map((role) => <span class="tag">{role}</span>)}
        </div>
        <div class="hero-actions" style="margin-top: 20px">
          {availableDownloads.find((d) => d.primary) && (
            <a
              class="btn-primary"
              href={`${base}${availableDownloads.find((d) => d.primary)!.filename.replace(/^\//, '')}`}
              download
            >
              PDF 이력서 다운로드
            </a>
          )}
          <a class="btn-secondary" href={`${base}contact/`}>Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="section-header">
        <div>
          <span class="eyebrow">Resume PDF</span>
          <h2>직무별 이력서 다운로드</h2>
          <p>퍼포먼스 마케팅, CRM·그로스, PM/Growth Analyst 포지션에 맞춘 PDF를 선택해 다운로드할 수 있습니다.</p>
        </div>
      </div>
      <div class="pdf-grid">
        {availableDownloads.map((item) => (
          <article class="pdf-card">
            {item.primary && <span class="pill">Recommended</span>}
            <h3>{item.label}</h3>
            <p>{item.description}</p>
            <div class="tag-list">
              {item.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <a class="btn-primary" href={`${base}${item.filename.replace(/^\//, '')}`} download style="margin-top: 16px; display: inline-flex;">
              다운로드
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="info-panel reveal">
        <h2>Core Positioning</h2>
        <p>광고 영업형 퍼포먼스 마케터가 아니라, 인하우스에서 광고비와 전환 지표를 보고 성과 개선 액션을 설계하는 퍼포먼스/그로스 마케터를 지향합니다.</p>
        <blockquote>{profile.oneLineIntro}</blockquote>
      </article>
      <article class="info-panel reveal">
        <h2>Core Tools</h2>
        <div class="tag-list">
          {coreTools.map((tool) => <span class="tag">{tool}</span>)}
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="section-header">
        <div>
          <span class="eyebrow">Tools</span>
          <h2>카테고리별 실무 도구</h2>
        </div>
      </div>
      <ToolStack />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Experience</span>
          <h2>직무 연결 중심 경력 요약</h2>
        </div>
      </div>
      <div class="timeline">
        {resumeTimeline.map((entry) => (
          <article class="timeline-item reveal">
            <span>{entry.category}{entry.company ? ` · ${entry.company}` : ''} · {entry.period}</span>
            <h3>{entry.title}</h3>
            <p>{entry.description}</p>
            {entry.bullets && entry.bullets.length > 0 && (
              <ul>
                {entry.bullets.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div class="reveal">
        <div class="section-header">
          <div>
            <span class="eyebrow">Education</span>
            <h2>학력</h2>
          </div>
        </div>
        <div class="timeline">
          {education.map((entry) => (
            <article class="timeline-item">
              <span>{entry.period}</span>
              <h3>{entry.school} {entry.degree}</h3>
              {entry.description && <p>{entry.description}</p>}
            </article>
          ))}
        </div>
      </div>
      <div class="reveal">
        <div class="section-header">
          <div>
            <span class="eyebrow">Supplementary Skills</span>
            <h2>보조 역량</h2>
          </div>
        </div>
        <div class="info-panel">
          {supplementarySkills.map((skill) => (
            <div style="margin-bottom: 16px">
              <div style="display: flex; justify-content: space-between; margin-bottom: 6px">
                <strong>{skill.name}</strong>
                <span style="color: var(--muted); font-size: 14px">{skill.category}</span>
              </div>
              <div class="bar-track" aria-label={`${skill.name} ${skill.level}`}>
                <span class="bar-fill" style={`width: ${skill.level}`}></span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    align-items: center;
  }

  .pdf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  .pdf-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    padding: 22px;
    box-shadow: var(--shadow);
  }

  .pdf-card h3 {
    margin-top: 10px;
  }

  .bar-track {
    height: 8px;
    background: var(--surface-soft);
    border-radius: 999px;
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    background: var(--primary);
    border-radius: 999px;
  }

  .timeline-item ul {
    margin-top: 12px;
    padding-left: 20px;
    color: var(--muted);
  }

  .timeline-item li {
    margin-bottom: 6px;
  }

  @media (max-width: 768px) {
    .resume-hero {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
