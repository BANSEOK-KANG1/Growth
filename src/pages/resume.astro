---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import ToolStack from '../components/ToolStack.astro';
import PdfDownloads from '../components/PdfDownloads.astro';
import PdfPreview from '../components/PdfPreview.astro';
import JdFitGrid from '../components/JdFitGrid.astro';
import { profile } from '../data/profile';
import { resumeTimeline, coreTools, supplementarySkills } from '../data/resume';
import { education } from '../data/profile';
import { allPdfDownloads, primaryResumeDownload } from '../data/pdfDownloads';
import { publicAssetExists, publicAssetUrl } from '../utils/assets';

const base = import.meta.env.BASE_URL;
const primaryPdf = primaryResumeDownload;
const hasPrimaryPdf = publicAssetExists(primaryPdf.filename);
---

<BaseLayout
  title={`Resume | ${profile.nameKo} — Growth Performance Marketer`}
  description={`${profile.nameKo}의 퍼포먼스·그로스·CRM 직무용 이력서 요약 및 PDF 다운로드.`}
  keywords={[...profile.keywords, '이력서', 'Resume PDF', profile.nameKo]}
>
  <section class="page-hero">
    <div class="container resume-hero reveal">
      <ProfilePhoto size="lg" />
      <div>
        <span class="eyebrow">Resume Summary</span>
        <h1>{profile.nameKo}</h1>
        <p>{profile.headline}</p>
        <p style="color: var(--muted); margin-top: 8px">
          {profile.location} · {profile.email} · {profile.phone}
        </p>
        <div class="tag-list">
          {profile.targetRoles.map((role) => <span class="tag">{role}</span>)}
        </div>
        <div class="hero-actions" style="margin-top: 20px">
          {hasPrimaryPdf ? (
            <a class="btn-primary" href={publicAssetUrl(base, primaryPdf.filename)} download>
              PDF 이력서 다운로드
            </a>
          ) : (
            <a class="btn-primary" href={`${base}contact/`}>Contact</a>
          )}
          <a class="btn-secondary" href={`${base}contact/`}>Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="section-header">
        <div>
          <span class="eyebrow">Resume PDF</span>
          <h2>직무별 이력서 · 포트폴리오 PDF</h2>
          <p>퍼포먼스 마케팅, CRM·그로스, PM/Growth Analyst 포지션에 맞춘 PDF를 선택해 다운로드할 수 있습니다.</p>
        </div>
      </div>
      <PdfDownloads items={allPdfDownloads} showEmpty />
    </div>
  </section>

  {
    hasPrimaryPdf && (
      <section class="section">
        <div class="container">
          <PdfPreview filename={primaryPdf.filename} title={primaryPdf.label} />
        </div>
      </section>
    )
  }

  <section class="section" id="jd-fit">
    <div class="container reveal">
      <div class="section-header">
        <div>
          <span class="eyebrow">JD Fit</span>
          <h2>그로스 마케터 JD 강점 매핑</h2>
          <p>
            자주 보이는 그로스 마케터 JD 8개 요건과 경험을 1:1로 연결했습니다. 이력서 bullet과 자소서 훅을 복사해
            지원서에 바로 활용할 수 있습니다.
          </p>
        </div>
      </div>
      <JdFitGrid base={base} />
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="info-panel reveal">
        <h2>Core Positioning</h2>
        <p>광고 영업형 퍼포먼스 마케터가 아니라, 인하우스에서 광고비와 전환 지표를 보고 성과 개선 액션을 설계하는 퍼포먼스/그로스 마케터를 지향합니다.</p>
        <blockquote>{profile.oneLineIntro}</blockquote>
      </article>
      <article class="info-panel reveal">
        <h2>Core Tools</h2>
        <div class="tag-list">
          {coreTools.map((tool) => <span class="tag">{tool}</span>)}
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="section-header">
        <div>
          <span class="eyebrow">Tools</span>
          <h2>카테고리별 실무 도구</h2>
        </div>
      </div>
      <ToolStack />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Experience</span>
          <h2>직무 연결 중심 경력 요약</h2>
        </div>
      </div>
      <div class="timeline">
        {resumeTimeline.map((entry) => (
          <article class="timeline-item reveal">
            <span>{entry.category}{entry.company ? ` · ${entry.company}` : ''} · {entry.period}</span>
            <h3>{entry.title}</h3>
            <p>{entry.description}</p>
            {entry.bullets && entry.bullets.length > 0 && (
              <ul>
                {entry.bullets.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div class="reveal">
        <div class="section-header">
          <div>
            <span class="eyebrow">Education</span>
            <h2>학력</h2>
          </div>
        </div>
        <div class="timeline">
          {education.map((entry) => (
            <article class="timeline-item">
              <span>{entry.period}</span>
              <h3>{entry.school} {entry.degree}</h3>
              {entry.description && <p>{entry.description}</p>}
            </article>
          ))}
        </div>
      </div>
      <div class="reveal">
        <div class="section-header">
          <div>
            <span class="eyebrow">Supplementary Skills</span>
            <h2>보조 역량</h2>
          </div>
        </div>
        <div class="info-panel">
          {supplementarySkills.map((skill) => (
            <div style="margin-bottom: 16px">
              <div style="display: flex; justify-content: space-between; margin-bottom: 6px">
                <strong>{skill.name}</strong>
                <span style="color: var(--muted); font-size: 14px">{skill.category}</span>
              </div>
              <div class="bar-track" aria-label={`${skill.name} ${skill.level}`}>
                <span class="bar-fill" style={`width: ${skill.level}`}></span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    align-items: center;
  }

  .bar-track {
    height: 8px;
    background: var(--surface-soft);
    border-radius: 2px;
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    background: var(--primary);
    border-radius: 2px;
  }

  .timeline-item ul {
    margin-top: 12px;
    padding-left: 20px;
    color: var(--muted);
  }

  .timeline-item li {
    margin-bottom: 6px;
  }

  @media (max-width: 768px) {
    .resume-hero {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
