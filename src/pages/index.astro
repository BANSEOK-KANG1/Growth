---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import MetricCard from '../components/MetricCard.astro';
import FunnelDiagram from '../components/FunnelDiagram.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import DashboardTable from '../components/DashboardTable.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import ToolStack from '../components/ToolStack.astro';
import ArchiveHub from '../components/ArchiveHub.astro';
import PortfolioCrossLinks from '../components/PortfolioCrossLinks.astro';
import { profile } from '../data/profile';
import { toolHighlights } from '../data/tools';
import { projects } from '../data/projects';
import { getResourceArchiveItems } from '../data/archive';
import type { ArchiveItem } from '../data/archive';
import { allPdfDownloads, primaryResumeDownload, portfolioDownload } from '../data/pdfDownloads';
import { publicAssetExists, publicAssetUrl } from '../utils/assets';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
const hasPrimaryPdf = publicAssetExists(primaryResumeDownload.filename);
const hasPortfolioPdf = publicAssetExists(portfolioDownload.filename);
const availablePdfCount = allPdfDownloads.filter((item) => publicAssetExists(item.filename)).length;

const previewArchiveItems: ArchiveItem[] = [
  ...cases.slice(0, 2).map((entry) => {
    const slug = String(entry.id).replace(/\.(md|mdx)$/, '');
    return {
      id: `preview-case-${slug}`,
      kind: 'case' as const,
      title: entry.data.title,
      summary: entry.data.summary,
      href: `${base}cases/${slug}/`,
      category: entry.data.category,
      period: entry.data.period,
      tags: entry.data.tools.slice(0, 2),
      featured: true
    };
  }),
  ...projects
    .filter((p) => p.featured)
    .slice(0, 2)
    .map((project) => ({
      id: `preview-project-${project.slug}`,
      kind: 'project' as const,
      title: project.title,
      summary: project.summary,
      href: project.externalUrl ?? `${base}projects/${project.slug}/`,
      category: 'Project',
      period: project.period,
      tags: project.tags.slice(0, 2),
      featured: true,
      external: Boolean(project.externalUrl)
    })),
  ...getResourceArchiveItems(base).slice(0, 1)
];
---

<BaseLayout
  title={`${profile.nameKo} | Growth Operations · Marketing Analytics Portfolio`}
  description={`${profile.headline} GA4/GTM·퍼널·리드 데이터·분석 도구 기반 Growth Operations 포트폴리오.`}
  ogType="profile"
  keywords={[...profile.keywords, '강반석', 'Kang Banseok', 'Growth Operations 포트폴리오']}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="reveal">
        <span class="eyebrow">Growth Operations · Marketing Analytics</span>
        <h1 class="hero-title">
          <span class="hero-title-line">채널을 운영하는 것보다,</span>
          <span class="typing-wrap" aria-live="polite">
            <span
              class="typing-text"
              data-typing
              data-phrases={JSON.stringify([
                '성장 문제를 구조화합니다',
                '측정 기준을 먼저 만듭니다',
                '데이터를 판단으로 바꿉니다',
                '실행 우선순위를 명확히 합니다'
              ])}
            >성장 문제를 구조화합니다</span>
          </span>
        </h1>
        <p class="lead">{profile.headline}</p>
        <p class="lead" style="font-size: 17px; color: var(--muted)">{profile.summary}</p>
        <blockquote class="hero-intro">{profile.oneLineIntro}</blockquote>
        <div class="hero-stats">
          <div class="hero-stat">
            <strong data-count={4} data-suffix="">4</strong>
            <span>구조화된 케이스</span>
          </div>
          <div class="hero-stat">
            <strong data-count={3} data-suffix="">3</strong>
            <span>분석 도구 · 대시보드</span>
          </div>
          <div class="hero-stat">
            <strong data-count={1} data-suffix="">1</strong>
            <span>공통 의사결정 프레임</span>
          </div>
        </div>
        <div class="hero-actions">
          <a class="btn-primary" href={`${base}work/`}>Work Archive 보기</a>
          <a class="btn-secondary" href={`${base}baro-interactive/`}>바로인터랙티브 JD Fit</a>
          {hasPrimaryPdf && (
            <a class="btn-secondary" href={publicAssetUrl(base, primaryResumeDownload.filename)} download>
              이력서 PDF
            </a>
          )}
          {hasPortfolioPdf && (
            <a class="btn-secondary" href={publicAssetUrl(base, portfolioDownload.filename)} download>
              포트폴리오 PDF
            </a>
          )}
        </div>
        <PortfolioCrossLinks current="home" />
        <div class="tag-list">
          {profile.keywords.map((keyword) => <span class="tag">{keyword}</span>)}
          {toolHighlights.slice(0, 4).map((tool) => <span class="tag">{tool}</span>)}
        </div>
      </div>

      <aside class="hero-aside reveal">
        <ProfilePhoto size="lg" />
        <div class="hero-panel" data-tilt aria-label="Portfolio snapshot">
          <div class="panel-title">
            <div>
              <strong>Portfolio Focus</strong>
              <span>Problem → Metric → Action</span>
            </div>
            <span class="pill">2026</span>
          </div>
          <div class="metric-stack">
            <div class="metric-row">
              <strong>Problem</strong>
              <p>성과 현상을 그대로 받아들이지 않고, 어디에서 판단이 막히는지 먼저 정의합니다.</p>
            </div>
            <div class="metric-row">
              <strong>Measurement</strong>
              <p>UTM, GTM, GA4, Airbridge로 유입·행동·전환을 비교 가능한 기준으로 정리합니다.</p>
            </div>
            <div class="metric-row">
              <strong>Decision & Ops</strong>
              <p>데이터를 보고서에서 끝내지 않고 유지·중단·실험 우선순위와 운영 구조로 연결합니다.</p>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Tool Stack</span>
          <h2>도구의 개수보다 어디에 사용했는지를 보여줍니다</h2>
          <p>광고 운영, 측정, 분석, 기획·제작 도구를 문제 정의와 의사결정 과정에서 어떻게 활용했는지 정리했습니다.</p>
        </div>
      </div>
      <ToolStack />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Core Capability</span>
          <h2>좋은 회사에서 보고 싶은 실무 판단 구조</h2>
          <p>툴 사용 경험보다 “어떤 지표로 보고, 어떤 판단을 하고, 어떤 액션으로 연결하는가”를 전면에 둡니다.</p>
        </div>
      </div>
      <SkillsGrid />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Growth Funnel</span>
          <h2>채널 지표를 사용자와 비즈니스의 성장 퍼널로 연결합니다</h2>
          <p>유입부터 행동·문의·후속 전환까지 각 단계에서 다른 문제와 판단 기준을 봅니다.</p>
        </div>
      </div>
      <FunnelDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Work Archive</span>
          <h2>케이스 · 프로젝트 · 지원 자료 한눈에</h2>
          <p>분산된 메뉴 대신 필터 하나로 실무 케이스, Live Demo, JD Fit까지 빠르게 찾을 수 있습니다.</p>
        </div>
        <div class="section-header-actions">
          <a class="text-link" href={`${base}work/`}>전체 아카이브 →</a>
          <a class="text-link" href={`${base}baro-interactive/`}>바로인터랙티브 →</a>
        </div>
      </div>
      <ArchiveHub items={previewArchiveItems} compact />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Featured Cases</span>
          <h2>Case Studies</h2>
          <p>각 케이스는 문제, 지표, 판단 기준, 액션, 한계와 다음 단계까지 같은 구조로 정리했습니다.</p>
        </div>
        <a class="text-link" href={`${base}cases/`}>전체 보기 →</a>
      </div>
      <div class="case-grid">
        {cases.map((entry) => <CaseCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container project-highlight reveal">
      <div class="info-panel">
        <span class="eyebrow">Featured Project</span>
        <h2 style="margin-top: 16px">Meta Creative Intelligence</h2>
        <p>Meta API 소재 메타 + CPA/CTR/CVR 성과를 통합해 포맷·훅·CTA 패턴을 분석하고, 다음 영상/크리에이티브 방향 브리프를 생성합니다.</p>
        <div class="hero-actions">
          <a class="btn-primary" href={`${base}projects/meta-creative-intelligence/`}>프로젝트 보기</a>
          <a class="btn-secondary" href={`${base}cases/performance-funnel-analysis/`}>관련 케이스</a>
        </div>
      </div>
      <div class="dashboard-card">
        <h3>Creative Pattern Pipeline</h3>
        <p>Meta API → Creative Meta + Insights → Pattern Analysis → Direction Brief</p>
        <div class="tag-list" style="margin-top: 12px">
          <span class="tag">Meta Marketing API</span>
          <span class="tag">Python</span>
          <span class="tag">Streamlit</span>
          <span class="tag">CPA · Hook · CTA</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container project-highlight reveal">
      <div class="info-panel">
        <span class="eyebrow">Featured Project</span>
        <h2 style="margin-top: 16px">Marketing Keyword Gap → Shoot Brief</h2>
        <p>KR 대중 트렌드 vs 마케팅 키워드 gap → 포맷·훅·제목·태그가 담긴 Shoot Brief 1장으로 이번 주 촬영 액션을 도출합니다.</p>
        <div class="hero-actions">
          <a class="btn-primary" href={`${base}projects/youtube-trend-analyzer/`}>프로젝트 보기</a>
          <a class="btn-secondary" href={`${base}projects/marketing-lead-dashboard/`}>대시보드 프로젝트</a>
        </div>
      </div>
      <div class="dashboard-card">
        <h3>API Pipeline Snapshot</h3>
        <p>Trending API → ETL → Category/Engagement 분석 → Insight Report</p>
        <div class="tag-list" style="margin-top: 12px">
          <span class="tag">YouTube Data API</span>
          <span class="tag">Python</span>
          <span class="tag">pandas</span>
          <span class="tag">4 Modes</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container project-highlight reveal">
      <div class="info-panel">
        <span class="eyebrow">Featured Project</span>
        <h2 style="margin-top: 16px">Marketing Lead Funnel Dashboard</h2>
        <p>광고 채널별 유입부터 문의, 진성문의, 미팅, 매출까지 이어지는 퍼널을 분석하고 개선 액션을 도출하는 대시보드 프로젝트입니다.</p>
        <div class="hero-actions">
          <a class="btn-primary" href={`${base}projects/marketing-lead-dashboard/`}>프로젝트 보기</a>
          <a class="btn-secondary" href={`${base}projects/`}>전체 프로젝트</a>
        </div>
      </div>
      <div class="dashboard-card">
        <h3>Channel Decision Snapshot</h3>
        <p>샘플 데이터 기준. 실제 데이터는 익명화/범위값 처리 권장.</p>
        <DashboardTable compact />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-3">
      <MetricCard label="Position" value="Growth Ops" description="마케팅·데이터·제품 사이의 측정 기준과 운영 구조를 정리합니다." />
      <MetricCard label="Core Logic" value="Problem → Metric" description="현상을 문제로 정의하고, 대표 지표와 판단 기준을 먼저 세웁니다." />
      <MetricCard label="Next Step" value="Analytics / PM" description="지표 기반 성장 문제 해결과 Product Operations로 확장합니다." />
    </div>
  </section>

  <section class="section contact-cta">
    <div class="container info-panel contact-cta-panel">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>성장 문제와 판단 기준을 함께 정리할 팀을 찾고 있습니다</h2>
        <p>Growth Operations, Marketing Analytics, CRM/Marketing Ops, Growth PM·Product Operations 포지션을 중심으로 지원합니다.</p>
        {availablePdfCount > 0 && (
          <p style="margin-top: 12px; color: var(--muted); font-size: var(--text-sm)">
            {availablePdfCount}개 직무별 이력서 PDF를 Resume 페이지에서 바로 다운로드할 수 있습니다.
          </p>
        )}
      </div>
      <div class="hero-actions">
        <a class="btn-primary" href={`${base}contact/`}>연락하기</a>
        <a class="btn-secondary" href={`${base}resume/`}>이력서 · PDF</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-intro {
    margin: 20px 0 0;
    padding: 14px 16px;
    border-left: 2px solid var(--primary);
    background: var(--surface-soft);
    border-radius: 0;
    font-size: var(--text-base);
    color: var(--text);
    line-height: 1.7;
  }

  .hero-title .typing-text {
    color: var(--primary-dark);
  }

  .hero-title .typing-text::after {
    background: var(--primary);
  }

  .contact-cta-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .contact-cta-panel h2 {
    margin-top: 12px;
  }

  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  @media (max-width: 768px) {
    .contact-cta-panel {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
