---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHub from '../../components/ArchiveHub.astro';
import { archiveKindDescriptions } from '../../data/archive';
import type { ArchiveItem } from '../../data/archive';
import { getResourceArchiveItems } from '../../data/archive';
import { projects } from '../../data/projects';

const base = import.meta.env.BASE_URL;
const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

const caseItems: ArchiveItem[] = cases.map((entry) => {
  const slug = String(entry.id).replace(/\.(md|mdx)$/, '');
  return {
    id: `case-${slug}`,
    kind: 'case',
    title: entry.data.title,
    summary: entry.data.summary,
    href: `${base}cases/${slug}/`,
    category: entry.data.category,
    period: entry.data.period,
    tags: [...entry.data.tools.slice(0, 2), ...entry.data.metrics.slice(0, 2)],
    featured: entry.data.order === 1
  };
});

const projectItems: ArchiveItem[] = projects.map((project) => ({
  id: `project-${project.slug}`,
  kind: 'project',
  title: project.title,
  summary: project.summary,
  href: project.externalUrl ?? `${base}projects/${project.slug}/`,
  category: 'Project',
  period: project.period,
  tags: project.tags,
  featured: project.featured,
  external: Boolean(project.externalUrl)
}));

const archiveItems = [...caseItems, ...projectItems, ...getResourceArchiveItems(base)].sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return 0;
});
---

<BaseLayout
  title="Work Archive | Kang Banseok Portfolio"
  description="실무 케이스, 프로젝트, 지원 자료를 한 화면에서 필터링해 볼 수 있는 작업 아카이브입니다."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Work Archive</span>
      <h1>케이스 · 프로젝트 · 지원 자료 한눈에</h1>
      <p>
        Cases와 Projects, Resume/JD Fit을 분산하지 않고 한 화면에서 필터로 정리했습니다. 채용 담당자가
        <strong>실무 판단 → 도구 → 지원 문서</strong> 순으로 빠르게 훑을 수 있게 구성했습니다.
      </p>
      <div class="archive-kind-legend">
        {Object.entries(archiveKindDescriptions).map(([kind, desc]) => (
          <div class="archive-kind-legend__item">
            <span class={`archive-kind archive-kind--${kind}`}>{kind === 'case' ? '실무 케이스' : kind === 'project' ? '프로젝트' : '지원 자료'}</span>
            <span>{desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <ArchiveHub items={archiveItems} />
    </div>
  </section>
</BaseLayout>

<style>
  .archive-kind-legend {
    display: grid;
    gap: 10px;
    margin-top: 24px;
    max-width: 720px;
  }

  .archive-kind-legend__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .archive-kind {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .archive-kind--case {
    background: rgba(18, 122, 85, 0.12);
    color: var(--success);
  }

  .archive-kind--project {
    background: rgba(36, 87, 197, 0.1);
    color: var(--primary);
  }

  .archive-kind--resource {
    background: var(--warning-bg);
    color: var(--warning);
  }
</style>
