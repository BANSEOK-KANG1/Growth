---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Projects | Kang Banseok Portfolio" description="퍼포먼스/그로스 마케팅 관련 프로젝트 목록입니다.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Projects</span>
      <h1>데이터와 판단 구조를 보여주는 프로젝트</h1>
      <p>광고 성과 분석, 전환 측정, CRM 실험을 하나의 흐름으로 연결하는 프로젝트를 정리합니다.</p>
    </div>
  </section>

  <section class="section">
    <div class="container case-grid">
      {projects.map((project) => (
        <article class="card project-card">
          {project.featured && <span class="pill">Featured</span>}
          <h2>{project.title}</h2>
          <p>{project.summary}</p>
          <div class="tag-list">
            {project.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <a class="btn-primary" href={`${base}projects/${project.slug}/`} style="margin-top: 20px; display: inline-flex;">
            프로젝트 보기
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
