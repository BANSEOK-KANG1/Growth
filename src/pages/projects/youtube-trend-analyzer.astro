---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeTrendDemo from '../../components/YouTubeTrendDemo.astro';
import { youtubeTrendProject } from '../../data/youtubeTrend';

const base = import.meta.env.BASE_URL;
const p = youtubeTrendProject;
---

<BaseLayout
  title="YouTube KR Trend Analyzer | Kang Banseok Portfolio"
  description="YouTube Data API 기반 KR 트렌드 분석 허브 프로젝트입니다."
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="eyebrow">Project · {p.period} · {p.role}</span>
      <h1>{p.title}</h1>
      <p>{p.problem}</p>
      <div class="tag-list" style="margin-top: 16px">
        {p.tools.map((tool) => <span class="tag">{tool}</span>)}
      </div>
      <div class="hero-actions" style="margin-top: 20px">
        {p.liveDemoUrl ? (
          <a class="btn-primary" href={p.liveDemoUrl} target="_blank" rel="noreferrer">Live App (Streamlit)</a>
        ) : (
          <span class="btn-secondary" style="opacity: 0.7; cursor: default">Live App · Streamlit Cloud URL 연결 후 활성화</span>
        )}
        <a class="btn-secondary" href={p.githubUrl} target="_blank" rel="noreferrer">GitHub / README</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="eyebrow">Interactive Demo</span>
          <h2>KR 트렌딩 · 키워드 · Content Brief</h2>
          <p>
            {p.liveDemoUrl
              ? '아래는 포트폴리오용 목업입니다. KR 실데이터·키워드 overlap·Markdown Brief는 Live App에서 사용하세요.'
              : '포트폴리오용 정적 목업입니다. Streamlit Cloud 배포 후 Live App 링크가 활성화됩니다.'}
          </p>
        </div>
      </div>
      <YouTubeTrendDemo />
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="card reveal">
        <h2>Approach</h2>
        <ol>
          {p.approach.map((step) => <li>{step}</li>)}
        </ol>
      </article>
      <article class="card reveal">
        <h2>Key Metrics</h2>
        <div class="metric-mini-grid">
          {p.metrics.map((m) => (
            <div class="metric-mini">
              <strong>{m.value}</strong>
              <span>{m.label}</span>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container info-panel reveal">
      <h2>Learnings</h2>
      <ul>
        {p.learnings.map((item) => <li>{item}</li>)}
      </ul>
      <div class="hero-actions" style="margin-top: 20px">
        {p.liveDemoUrl ? (
          <a class="btn-primary" href={p.liveDemoUrl} target="_blank" rel="noreferrer">Live App (Streamlit)</a>
        ) : null}
        <a class="btn-primary" href={`${base}projects/`}>프로젝트 목록</a>
        <a class="btn-secondary" href={p.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .metric-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .metric-mini {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 14px;
    background: var(--surface-soft);
  }

  .metric-mini strong {
    display: block;
    font-size: 20px;
    color: var(--primary-dark);
  }

  .metric-mini span {
    font-size: 13px;
    color: var(--muted);
  }
</style>
